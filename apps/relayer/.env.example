# Sealround gas relayer. From apps/relayer: Copy-Item .env.example .env (git-ignored), then fill it in; see README.md.

# sandbox | testnet | mainnet (reported by /policy and /health)
NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org

# A dedicated account that does nothing but relay. Keep a small balance on it.
RELAYER_ACCOUNT_ID=fairground-relayer.testnet
# Full-access ed25519 secret key of RELAYER_ACCOUNT_ID. Never commit it. It is never logged.
RELAYER_PRIVATE_KEY=ed25519:replace-me

FAIRGROUND_CONTRACT=fairground.testnet
# USDC contracts bids may be paid in, comma-separated; the first is the /storage default.
# testnet: usdc.fakes.testnet (open mint) and Circle 3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af
# mainnet: Circle 17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
USDC_CONTRACTS=usdc.fakes.testnet,3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af

# Limits (these are the defaults)
# Relays paid per sender; refusals do not count.
RELAYS_PER_SENDER_PER_HOUR=30
REQUESTS_PER_IP_PER_HOUR=120
STORAGE_PER_IP_PER_DAY=3
# Hard cap on NEAR that relays cost per UTC day (gas burnt + deposits).
DAILY_BUDGET_NEAR=5
# Hard cap on NEAR that USDC storage registrations cost per UTC day, apart from the relay budget.
STORAGE_BUDGET_NEAR=0.5
# Cap on the gas of one relayed delegate, 1..300. Each relay in flight holds gas x 1e9 yocto of the balance.
MAX_GAS_TGAS=150
# A delegate may have at most this many blocks left before it expires.
MAX_DELEGATE_BLOCKS=1200
# How long to wait for the outcome once the transaction is in a block, before answering "pending"; 0 answers then.
RELAY_WAIT_MS=15000

# Server
PORT=8787
# Browser origins allowed to call the relayer, comma-separated. Empty: no CORS headers.
CORS_ORIGINS=http://localhost:3000
# Behind a proxy, the header that carries the client IP: x-real-ip (Vercel), fly-client-ip (Fly),
# cf-connecting-ip (Cloudflare), or x-forwarded-for. Empty: the socket address (direct connections only).
CLIENT_IP_HEADER=
# How many of your own proxies append to CLIENT_IP_HEADER; the client is that many entries from the right.
TRUSTED_PROXY_HOPS=1
