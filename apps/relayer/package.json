{
  "name": "@fairground/relayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gas relayer for Sealround: relays NEP-366 meta transactions for bids and claims, and sponsors USDC storage for new bidders.",
  "exports": {
    ".": "./src/lib.ts",
    "./api": "./src/api.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "dev:sandbox": "node --env-file=.env.sandbox --watch src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:sandbox": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-sandbox.ps1"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "borsh": "2.0.0",
    "hono": "4.13.17",
    "near-api-js": "7.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
